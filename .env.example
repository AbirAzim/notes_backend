NODE_ENV=development
PORT=3000

MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@your-cluster.mongodb.net/notes_dev

CORS_ORIGIN=http://localhost:5173

# generate each with: openssl rand -hex 32 (use different values)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_VERIFY_SECRET=

FRONTEND_URL=http://localhost:5173

# first admin, created once on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123

# Gmail: use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=
MAIL_FROM=Secure Notes <your-address@gmail.com>